# ---------------------------------------------------------------------------
# ReachInbox Email Job Scheduler — environment
# Copy to `.env` (same folder as server.ts) and fill in real values.
# Loaded automatically by dotenv at server start.
# Values that are NOT set fall back to built-in dev/demo behaviour.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Used for OAuth post-login redirects (must match the URL you open the app on)
FRONTEND_URL=http://localhost:3000

# --- Google OAuth (BACKEND.md §15 / UNIFY.md §9) ----------------------------
# Leave blank to use the built-in simulated sign-in on the login screen.
# Google Console:
#   Authorized JavaScript origins : http://localhost:3000
#   Authorized redirect URI       : http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Slack OAuth + notifications (BACKEND.md §16) ---------------------------
# Leave blank to use the simulated connect flow + local alert feed.
# Slack App → Redirect URL: http://localhost:3000/api/slack/callback
# Bot Token Scopes: chat:write, incoming-webhook
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional server-wide fallbacks when a user has not connected Slack
SLACK_WEBHOOK_URL=
SLACK_ACCESS_TOKEN=

# --- Ethereal fake SMTP (BACKEND.md §12) ------------------------------------
# Leave blank to auto-create a fresh Ethereal test account on every boot.
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Queue worker tuning (SYSTEM_DESIGN.md §6.3) ---------------------------
WORKER_CONCURRENCY=5
JOBS_PER_INTERVAL=10
LIMITER_INTERVAL_MS=1000
DELAY_BETWEEN_EMAILS_MS=2000
DEFAULT_HOURLY_LIMIT=100
# Automatic retries (BACKEND.md §7.1): attempts with exponential backoff
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=2000

# --- Unused by this build, kept for the documented stack -------------------
# The runtime store is data/db.json (no NeonDB/Redis/Elasticsearch required).
# See audit.md for the swap-in notes.
# DATABASE_URL=
# REDIS_URL=redis://localhost:6379
# ELASTICSEARCH_URL=http://localhost:9200
